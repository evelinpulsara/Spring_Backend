# Copia este archivo como ".env" (en esta misma carpeta) y pon tu clave.
# El archivo .env NO se sube a GitHub.
# Clave gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=pega-aqui-tu-clave
# Opcional: otro modelo de Gemini
# GEMINI_MODEL=gemini-3.8-flash

# ── Base de datos (solo para usar Supabase; sin esto se usa una base local) ──
# DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.TU_PROYECTO
# DB_PASSWORD=tu-contraseña-de-supabase

# ── Sesión ──
# JWT_SECRET=una-frase-larga-y-secreta-de-al-menos-32-caracteres
